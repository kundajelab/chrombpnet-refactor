# Byte-compiled / cached
__pycache__/
*.py[cod]
*.so
.ipynb_checkpoints

# Packaging / build output
*.egg-info/
build/
dist/

# Test and coverage caches
.pytest_cache/
.coverage
htmlcov/

# Local scratch directories
results/
experimental_scripts/
tracks/
needs_cleanup/
old/

# Model checkpoints and large genomics outputs produced by pipeline runs.
# Listed explicitly rather than via a blanket rule so that committed fixtures
# and snapshots are never silently excluded.
*.pt
*.bw
*.h5

# Claude Code worktrees: never commit them (4568ff4 recorded one as a gitlink).
.claude/
