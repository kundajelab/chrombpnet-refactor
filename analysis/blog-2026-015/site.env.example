# Site configuration for the blog 2026-015 scripts. Copy this file to site.env (in this folder,
# or anywhere, with BLOG_SITE_ENV=<path>) and fill in what the scripts you run need: each script
# stops and names any value it needs that is left empty. Values are bash: quote paths with
# spaces. A value already in the environment (VAR=... ./script.sh) wins over this file's.

# --- Code ---------------------------------------------------------------------------------------
# CHROMBPNET_REPO=       # chrombpnet-refactor checkout (default: the repository holding these scripts)
ORIGINAL_REPO=           # chrombpnet 1.x checkout (github.com/kundajelab/chrombpnet), at 09938fd
KIT_ROOT=                # optimization kit checkout (github.com/anthropics/uplifting-biomolecular-modeling)
KIT_HOME=                # the kit's weights, data and JIT-cache directory (its README: install)
CHROMBPNET_EXPAND_REPO=  # chrombpnet-refactor checkout at 3ddb713 (the last with --model-selection pearsonr-jsd), which expand/ runs

# --- Reference data -----------------------------------------------------------------------------
GENOME=                  # hg38 FASTA (with its .fai beside it)
CHROM_SIZES=             # hg38 chromosome sizes
REFERENCE_DIR=           # folds/fold_<k>.json (ENCODE's 5 chromosome splits), blacklist.bed.gz and motif files

# --- Environments -------------------------------------------------------------------------------
CONDA_ROOT=              # conda installation holding the environments (bin/conda, envs/): chrombpnet-pytorch, chrombpnet, ...
CONTAINER_IMAGE=         # Ubuntu 22.04 Apptainer image for jobs on glibc 2.17 hosts (cherimoya, --container runs)
# CONTAINER_BINDS=       # host directories bound into the container, space-separated: wherever envs, checkouts, data and outputs live
# PT_ENV_GLIBC217=       # conda env name of a PyTorch build for glibc 2.17 nodes (envs/chrombpnet-pytorch-glibc.yml); under Slurm,
#                        # optimization/ and expand/ default to it, dnase-rc/ uses it when CONDA_ENV names it
# TF28_LIBRARY_DIRS=     # CUDA 11.2 and cuDNN 8.1 lib directories, colon-separated, for TensorFlow 2.8 (engines/; else the hook below)

# --- Cluster ------------------------------------------------------------------------------------
LOG_DIR=                 # where submit scripts send Slurm logs (sbatch -o / -e), and check_runs.sh reads them
SBATCH_SITE_ARGS=        # sbatch options every submission gets, e.g. "--partition=... --exclude=..."
SBATCH_L40S=             # sbatch options that select an NVIDIA L40S node, e.g. "--constraint=<feature>"
SBATCH_H200=             # the same for an NVIDIA H200 node (with its partition, if it has one)
SBATCH_H100=             # the same for an NVIDIA H100 node (optimization/'s September sweep)
# JAX_GPU_CONSTRAINT=    # sbatch --constraint for engines/' JAX jobs: GPUs of compute capability 7.5 or newer
# TF_GPU_CONSTRAINT=     # sbatch --constraint for engines/' TensorFlow jobs: GPUs of 16 GB or more
# SBATCH_SHARED_GPU_ARGS= # sbatch options for a GPU in shared compute mode, if the cluster's default is Exclusive_Process

# Optional hooks, run where a script needs them (define only what your site needs), e.g. on a
# cluster with environment modules:
# site_tf28_libraries()   { module load cuda/11.2.0; module load cudnn/8.1.1.33; }  # TensorFlow 2.8 (chrombpnet 1.x)
# site_report_libraries() { module load system pango; module load system cairo; }  # 1.x's PDF report (WeasyPrint)
# site_kit_compiler()     { module load gcc/14.2.0; }                              # C11 compiler for Triton launchers
# site_pytorch_compiler() { module load gcc/14.2.0; }                              # a newer libstdc++ for PT_ENV_GLIBC217

# --- optimization/ ------------------------------------------------------------------------------
REFACTOR_MODELS=         # chrombpnet-refactor's models: ATAC/ENCSR868FGK/fold_<k>/model/{models,auxiliary}/
ORIGINAL_MODELS=         # chrombpnet 1.x's models of the same folds, laid out alike: .../fold_<k>/model/models/*.h5
CHERIMOYA_MODELS=        # CATv1's models: ATAC/ENCSR868FGK/fold_<k>/cherimoya.torch (its kernel cache goes in .cache/)
OPTIMIZATION_OUT=        # run tree of the blog's pred_bw jobs (their OUT_ROOT; the summarizers' ANALYSIS_DIR)
OPTIMIZATION_ANALYSIS=   # run tree of the September sweep (run_chrombpnet_optimization_*.sh, summarize.sh)
BENCHMARK_RUNS=          # where that sweep's training left chrombpnet-refactor-<level>-cleanup/<assay>/<ENCID>/
# CONTAINER_UNDER_SLURM= # 1: under Slurm, run cherimoya (needs glibc >= 2.28) in CONTAINER_IMAGE

# --- engines/ and expand/ -----------------------------------------------------------------------
ENGINES_ROOT=            # the engines sweep's run tree: engines/ writes it, expand/ reads its pytorch/ runs and nonpeaks
ENGINES_IDS=             # the sweep's dataset x fold table (tab-separated, header ASSAY ENCID BAM_PATH PEAKS_BED_PATH FOLD_NUM ...)
ENCODE_MODELS=           # ENCODE's ChromBPNet models: <dir>/<ASSAY>/<ENCID>/models/fold_N/model.chrombpnet_nobias.fold_N.<ENCID>.h5
EXPAND_ROOT=             # expand/'s run tree (its preprocess/ is a link to ${ENGINES_ROOT}/preprocess)

# --- dnase-rc/ ----------------------------------------------------------------------------------
DNASE_RC_ROOT=           # the cut-site sweep's run tree: <arm>/<ASSAY>/<ENCID>/fold_<N>/, comparisons/, analysis/
DNASE_RC_IDS=            # its ids table: ASSAY ENCID BAM_PATH PEAKS_BED_PATH FOLD_NUM TENSORFLOW_DIR ..., one row per fold
ATLAS_DIR=               # the ENCODE chromatin atlas: <ASSAY>/<ENCID>/preprocessing/{downloads,bigWigs}/ (bias-counts/ too)
RAW_BAM_DIR=             # holds ENCSR868FGK/merged.bam, which 00_prepare_bams.sh links instead of downloading

# --- blog-figures/ ------------------------------------------------------------------------------
BLOG_DIR=                # the blog post's folder: make_blog_figures.sh writes the figures there
BLOG_FIGURES_WORK=       # inputs and intermediate plots for make_blog_figures.sh
# ENGINES_SUMMARY=       # engines/run_summarize.sh's output (default: ${ENGINES_ROOT}/analysis/profile-stopgrad-off)
# EXPAND_ANALYSIS=       # expand's analysis directory (default: ${EXPAND_ROOT}/analysis)
